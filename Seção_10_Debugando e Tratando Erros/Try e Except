def pega_valor(dicionario,chave):
    try:
        return dicionario[chave]
    except:
        return None #Forma de tratar o erro

dicio = {'nome': 'Geek'}
print(pega_valor(dicio,'nome')) 
print(pega_valor(dicio,'game')) #Com erro

