#Exemplo any()


"""
nomes = ['Carlos', 'Camila', 'Carla', 'Cassiano', 'Cristiana', 'Vanessa']

print(all(nome[0]=='C' for nome in nomes)) #False
print(any(nome[0]=='C' for nome in nomes)) #True


print(all([num for num in [4,2,10,6,8,9] if num %2 ==0])) #True
print(all([num %2 ==0 for num in [4,2,10,6,8,9]])) #False


#O jeito certo de montar
numeros = [4, 2, 10, 6, 8, 9]

# Aqui ele testa cada número e gera [True, True, True, True, True, False]
print(all(num % 2 == 0 for num in numeros))
