#3
##Função Quadrática
#f(x) = a*x**2 + b*x + c

#Definindo a Função
def funcao_quadratica(a,b,c):
    """Retorna f(x) = a*x**2 + b*x + c"""
    return lambda x: a*x**2 + b*x + c

#Informando os argumentos da def funcao_quadratica
teste = funcao_quadratica(2,3,-5) 

#Informando o argumento da função Lambda
print(teste(0)) 
print(teste(1))
print(teste(2))
print(teste(3))
print('\n')

#Informando os argumentos da def funcao_quadratica e o argumento da função lambda
print(funcao_quadratica(2,3,-5)(0))
print(funcao_quadratica(2,3,-5)(1))
print(funcao_quadratica(2,3,-5)(2))
print(funcao_quadratica(2,3,-5)(3))