#→ Como combinar filter() e map()
nomes = ['Vanessa', 'Ana', 'Maria']

#Devemos criar uma lista contendo 'Sua instrutora é' + nome, 
# desde que o nome tenha nos de 5 caracteres

lista = list(
    map(lambda nome: f'Sua instrutora é {nome}', 
            filter(lambda nome: len(nome) <5, nomes)
        )
)

