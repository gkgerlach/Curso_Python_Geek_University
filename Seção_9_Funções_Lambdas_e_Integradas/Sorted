#Podemos utilizar o sorted() para coisas mais complexas
usuarios = [
    {"username":"samuel","tweets": ["Eu adoro bolos","Eu adoro pizzas"]},
    {"username":"carla","tweets": ["Eu amo gatos"]},
    {"username":"jeff","tweets": []},
    {"username":"bob123","tweets": [], "cor":"amarelo"},
    {"username":"doggo","tweets": ["Eu gosto de cachorro","Bora dar role!"]},
    {"username":"gal","tweets": [], "cor":"preto", "musica":"rock"}
            ] #Lista dentro de dicionário que está dentro de lista

print(usuarios)
#print(sorted(usuarios)) #Não é possível pois não consegue iterar na lista
print(sorted(usuarios, key=lambda usuario: usuario["username"])) #Ordenando pela ordem alfabética dos usuários
print(sorted(usuarios, key=lambda usuario: usuario["username"], reverse=True)) #Ordenando pela ordem alfabética dos usuários de trás para frente


#Caso queira fazer pelo ordem do "Tweet"
usuarios_ordenados = sorted(usuarios, key=lambda usuario: usuario['tweets'])

#Contando a quantidade de tweets de cada usuario
for u in usuarios_ordenados:
    print(f'{u['username']}: {len(u['tweets'])}')


#Ordenando pela quantidade de tweets
print(sorted(usuarios, key=lambda usuario: len(usuario['tweets']), 
        reverse=True
        ))
