"""
3. Faça um programa que leia 10 valores, armazene-os em uma lista
e apresente quantos valores pares ele possui

"""

lista: list[int] = []

while len(lista) <10:
    valor: int = int(input(f'Informe o valor {len(lista)+1}/10: '))
    lista.append(valor)

quantidades_pares = 0
for valor in lista:
    if valor % 2 == 0:
        print(f'O número {valor} é par')
        quantidades_pares = quantidades_pares + 1
    else:
        print(f'O número {valor} é impar')

print(f'Ao todo temos {quantidades_pares} nessa lista')
lista.sort()
print(f'Sua lista: {lista}')
