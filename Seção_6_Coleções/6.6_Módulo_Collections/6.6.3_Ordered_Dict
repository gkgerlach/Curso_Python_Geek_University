# Entendendo a diferença entre Dict e Ordered Dict

# Dict
dict1 = dict(a=1, b=2) # ou dict1 = {'a':'1', 'b':2}
dict2 = dict(b=2, a=1)

print(dict1 == dict2) #True, já que a ordem nos elementos não importam

# Ordered Dict
from collections import OrderedDict
odict1 = OrderedDict(dict(a=1,b=2))
odict2 = OrderedDict(dict(b=2,a=1))

print(odict1==odict2) #False, já que a ordem importa para o OrderedDict