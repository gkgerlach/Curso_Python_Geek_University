6.1.20 - Revisão de Slicing
# Revisão slicing
# lista[início:fim:passo]
# range[início:fim:passo]

lista = [1, 2, 3, 4]
print(lista[::])  # Todos os elementos
print(lista[1:])  # Começando pelo índice 1
print(lista[1])  # Indice 1
print(lista[:2])  # Começa em 0 e finalizando no índice 2-1=1
print(lista[:4])  # Começa em 0 e finalizando no índice 4-1=3
print(lista[1:3])  # Começa em 1 e finalizando no índice 3-1=2

print(lista[::2])  # Começa em 0 com passo 2
print(lista[1::2])  # Começa em 1 com passo 2

print(lista[1::-1])  # Começa em 1 com passo -1

