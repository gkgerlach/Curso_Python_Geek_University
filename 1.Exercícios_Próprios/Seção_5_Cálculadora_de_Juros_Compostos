# Desenvolvendo uma cálculadora de juros compostos

questao: str = str(input("Vamos trabalhar os valores em meses ou ano? "))
mont: float = float(input("Qual o valor do Capital Inicial: "))


if questao == "meses":
    i: float = float(input("Qual o valor do juros em %: "))
    t: int = int(input("Informe os meses de aplicação: "))
    print(f"Calculo feito para: {mont}")

    for mes in range(1, t + 1):
        mont = mont * (1 + (i / 100))
        print(f"Mês {mes}: {mont:.2f}")

elif questao == "ano":
    i: float = float(input("Qual o valor do juros em %: "))
    t: int = int(input("Informe os anos de aplicação: "))
    print(f"Calculo feito para: {mont}")

    for ano in range(1, t + 1):
        mont = mont * (1 + (i / 100))
        print(f"Ano {ano}: {mont:.2f}")

else:
    print("Você não selecionou nenhum dos itens: meses ou ano.")
