"""
Exercício 5) Balanço de Massa Acumulado (Reduce & Dict Comprehension):
Imagine que uma planta produziu as seguintes massas de polímero em 4 turnos: producao = [450.5, 520.2, 480.8, 495.3] (kg).

Use reduce() do módulo functools para calcular a massa total produzida no dia.

Use Dictionary Comprehension para criar um dicionário onde a chave é o número do turno (ex: "Turno 1") e
o valor é a massa, mas apenas para os turnos que produziram mais de 490 kg.

"""

from functools import reduce

producao = [450.5, 520.2, 480.8, 495.3]

# Questão 1
producao_total = reduce(lambda x, y: x + y, producao)
print(producao_total)

# Questão 2

turno = {
    f"Turno {n}": produto
    for n, produto in enumerate(producao, start=1)
    if produto > 490
}
print(turno)

