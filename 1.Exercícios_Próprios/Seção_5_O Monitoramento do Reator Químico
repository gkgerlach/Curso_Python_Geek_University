# Você é o engenheiro responsável por monitorar um tanque de reação.
## O processo é instável: entra fluido por uma válvula e sai por outra,
### mas as vazões podem fazer o tanque transbordar ou secar.

"""Objetivo: Criar um script que simule o nível do tanque minuto a minuto até que algo crítico
aconteça (transbordo ou esvaziamento) ou o tempo acabe."""

nivel_inicial: float = 500
capacidade: float = 1000
vazao_e: float = 50

print(
    f"As condições de operação são: \n Vazão {vazao_e} m³/h; \n Volume Inicial {nivel_inicial} m³"
)
vazao_s: float = float(input("Qual a vazão de saída na operação em m³/h: "))

tempo: int = 0

print("--- SIMULAÇÃO INICIADA ---")

while True:
    balance: float = float(nivel_inicial + (vazao_e - vazao_s) * tempo)

    if balance < 0:
        balance = 0
    print(f"Hora {tempo}: o volume do tanque é {balance} m³")

    if balance >= capacidade:
        print("ALERTA CRÍTICO: O TANQUE TRANSBORDOU")
        break

    if balance == 0:
        print("ALERTA: TANQUE VAZIO!")
        break

    if tempo > 100:
        print("Simulação interrompida. Tempo execido de 100h= horas")

    tempo = tempo + 1
