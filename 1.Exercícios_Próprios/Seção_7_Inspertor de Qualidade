def analisar_lote(pressoes: list) -> dict:
    media = round((sum(pressoes)/len(pressoes)),2)
    maior = max(pressoes)
    menor = min(pressoes)

    return {'Pressão Média':media,'Máxima Pressão':maior,'Mínima Pressão':menor }

if __name__=='__main__':
    minhas_pressoes = []
    
    print("Entrada de Dados do Lote (digite 'sair' para finalizar)")
    while True:
        entrada = input("Digite o valor da pressão verificada (ou 'sair'): ")
        if entrada.lower() == 'sair':
            break
        valor_numerico = float(entrada)
        minhas_pressoes.append(valor_numerico)  
    
    if len(minhas_pressoes) > 0:
        relatorio = analisar_lote(minhas_pressoes)
        print(relatorio)
    else: 
        print("Nenhum dado inserido")