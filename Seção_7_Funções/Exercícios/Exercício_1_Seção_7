print(num_dobro(3))
print(num_dobro(4))
"""

def dobro_numero(num: int):
    return 2*num

try:
    valor: int = int(input('Digite um número inteiro:'))
    resultado = dobro_numero(valor)
    print(f'O dobro de {valor} é {resultado}')

except:
    print('Erro: Precisa ser número inteiro')


