def exponencial(numero, potencia=2): #Colando um valor padrão parao parâmetro, no caso 2
    return numero**potencia


print(exponencial(2, 3))  # 2*2*2=8
print(exponencial(3, 2))  # 3*3

print(exponencial(3))  # Por padrão eleve ao quadrado -> Objetivo
print(exponencial(3, 5))  # Eleva a potência informada pelo usuário

#Errado
def exp(num=2, pot):
    return num ** pot
print(exp(6))

#Certo
def exp(pot, num=2):
    return num ** pot
print(exp(6))

# Exemplo mais complexo
def mostra_informacao(nome="Geek", instrutor=False):
    if nome == "Geek" and instrutor:
        return "Bem Vindo instrutor Geek!"
    elif nome == "Geek":
        return "Eu pensei que você era o instrutor"
    return f"Olá {nome}"


print(mostra_informacao())
print(mostra_informacao(instrutor=True))
print(mostra_informacao(True))
print(mostra_informacao("Ozzy"))
print(mostra_informacao(nome="Caio"))

